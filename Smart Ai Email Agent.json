        "jsCode": "const input = $json.body || $json;\nconst eventType = input.eventType || 'inquiry';\nconst label = eventType === 'booking' ? 'Booking request' : 'Customer inquiry';\nconst details = eventType === 'booking'\n  ? `Name: ${input.name || ''}\\nEmail: ${input.email || ''}\\nPhone: ${input.phone || ''}\\nCourse: ${input.course || ''}\\nSubject: ${input.subject || ''}\\nPreferred date: ${input.date || ''}\\nWork type: ${input.type || ''}\\nRequirements: ${input.requirements || ''}`\n  : `Name: ${input.name || ''}\\nEmail: ${input.email || ''}\\nCourse: ${input.course || ''}\\nMessage: ${input.message || ''}`;\nreturn [{ json: { snippet: `[${label}]\\n${details}`, Subject: `[NOTEMATE] ${label}`, source: input.source || 'email' } }];"
      },
